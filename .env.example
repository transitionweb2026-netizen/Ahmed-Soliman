# Copy to .env.local and fill in. Never commit real values.

# Public (safe in the browser) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public site address used for canonical URLs / sitemap (optional; the CMS "Site URL" setting wins)
NEXT_PUBLIC_SITE_URL=https://drahmedsoliman.com

# Server-side scripts only (npm run db:seed, npm run admin:create). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Database access for migrations (npm run db:migrate). Either a full connection string…
SUPABASE_DB_URL=
# …or just the database password (the script finds the connection pooler for the project).
SUPABASE_DB_PASSWORD=
